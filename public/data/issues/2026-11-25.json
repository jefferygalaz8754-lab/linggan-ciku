    {
      "id": "2026-11-25-09",
      "index": "09",
      "title": "Somebody That I Used to Know",
      "artist": "Gotye",
      "lyricist": "Wally De Backer",
      "language": "外文",
      "category": "独立 / 摇滚 / 民谣",
