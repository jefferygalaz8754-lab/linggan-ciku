  ],
  "quotes": [
    {
      "id": "2026-11-25-q01",
      "index": "01",
      "category": "外国文学",
      "emotion": "清醒刺痛",
      "technique": "递进设问与心理刺探",
      "text": "重要的不是治愈，而是带着病痛生活。",
      "source": "阿尔贝·加缪 · 《西西弗神话》"
    },
    {
      "id": "2026-11-25-q02",
      "index": "02",
      "category": "外国文学",
      "emotion": "疲惫疏离",
      "technique": "客观时间锚定",
      "text": "我们都在自己的废墟上苟延残喘，但仍假装一切体面。",
      "source": "萨缪尔·贝克特 · 《终局》"
    },
    {
      "id": "2026-11-25-q03",
      "index": "03",
      "category": "现当代文学",
      "emotion": "锋利自嘲",
      "technique": "温柔反讽",
      "text": "忠厚老实人的恶毒，像饭里的沙砾或者出骨鱼片里的刺，会给人一种不期待的伤痛。",
      "source": "钱锺书 · 《围城》"
    },
    {
      "id": "2026-11-25-q04",
      "index": "04",
      "category": "外国文学",
      "emotion": "底层写实与阶级困局",
      "technique": "底层写实与阶级困局",
      "text": "穷人的贫困并不是由于缺乏美德，而是由于缺乏金钱。",
      "source": "乔治·奥威尔 · 《巴黎伦敦落魄记》"
    },
    {
      "id": "2026-11-25-q05",
      "index": "05",
      "category": "外国文学",
      "emotion": "绝望挽留",
      "technique": "逻辑倒错",
      "text": "我爱你，以至于我宁愿你痛苦，也不愿你忘记我。",
      "source": "玛格丽特·杜拉斯 · 《情人》"
    },
    {
      "id": "2026-11-25-q06",
      "index": "06",
      "category": "纪实访谈",
      "emotion": "疲惫疏离",
      "technique": "客观时间锚定",
      "text": "痛苦并不会随着时间被抹平，它只是变成了身体里一块麻木的结石。",
      "source": "阿列克谢耶维奇 · 《切尔诺贝利的悲鸣》"
    },
    {
      "id": "2026-11-25-q07",
      "index": "07",
      "category": "外国文学",
      "emotion": "荒诞自嘲",
      "technique": "口语反转",
      "text": "一切正常，除了我的生活正在无声无息地烂掉。",
      "source": "弗朗茨·卡夫卡 · 《城堡》"
    },
    {
      "id": "2026-11-25-q08",
      "index": "08",
      "category": "外国文学",
      "emotion": "幻灭疏离",
      "technique": "温柔反讽",
      "text": "我们奋力前行，小舟逆水而上，不断地被推回过去。",
      "source": "F. S. 菲茨杰拉德 · 《了不起的盖茨比》"
    },
    {
      "id": "2026-11-25-q09",
      "index": "09",
      "category": "外国文学",
      "emotion": "清醒刺痛",
      "technique": "递进设问与心理刺探",
      "text": "当一个人意识到自己微不足道时，痛苦才真正具有了重量。",
      "source": "米兰·昆德拉 · 《不能承受的生命之轻》"
    },
    {
      "id": "2026-11-25-q10",
      "index": "10",
      "category": "外国文学",
      "emotion": "疲惫疏离",
      "technique": "物态化比喻",
      "text": "我就像一个被遗忘在空火车站台上的行李箱，任凭风吹日晒。",
      "source": "村上春树 · 《挪威的森林》"
    },
    {
      "id": "2026-11-25-q11",
      "index": "11",
      "category": "现当代文学",
      "emotion": "底层写实与阶级困局",
      "technique": "底层写实与阶级困局",
      "text": "人是为了活着本身而活着的，而不是为了活着之外的任何事物所活着。",
      "source": "余华 · 《活着》"
    },
    {
      "id": "2026-11-25-q12",
      "index": "12",
      "category": "优质影视",
      "emotion": "疲惫疏离",
      "technique": "客观时间锚定",
      "text": "到了凌晨三点，城市的霓虹灯熄灭，所有谎言都失去了观众。",
      "source": "王家卫 · 《重庆森林》"
    },
    {
      "id": "2026-11-25-q13",
      "index": "13",
      "category": "外国文学",
      "emotion": "绝望挽留",
      "technique": "递进设问与心理刺探",
      "text": "请不要温和地走进那个良夜，怒斥吧，怒斥光明的消逝。",
      "source": "狄兰·托马斯 · 《不要温和地走进那个良夜》"
    },
    {
      "id": "2026-11-25-q14",
      "index": "14",
      "category": "外国文学",
      "emotion": "锋利自嘲",
      "technique": "口语反转",
      "text": "成熟的标志，就是你终于能够体面地吞下咽不下去的残羹剩饭。",
      "source": "J. D. 塞林格 · 《麦田里的守望者》"
    },
    {
      "id": "2026-11-25-q15",
      "index": "15",
      "category": "现当代文学",
      "emotion": "清醒刺痛",
      "technique": "温柔反讽",
      "text": "真正的绝望是没有痛苦、没有悲伤，也没有眼泪的平淡无奇。",
      "source": "史铁生 · 《我与地坛》"
    },
    {
      "id": "2026-11-25-q16",
      "index": "16",
      "category": "外国文学",
      "emotion": "底层写实与阶级困局",
      "technique": "底层写实与阶级困局",
      "text": "生活就是这样，你以为已经到了谷底，其实地下还有十八层地下室。",
      "source": "路易-费迪南·塞利纳 · 《茫茫黑夜漫游》"
    },
    {
      "id": "2026-11-25-q17",
      "index": "17",
      "category": "外国文学",
      "emotion": "荒诞自嘲",
      "technique": "逻辑倒错",
      "text": "他们假装在支付我们的工资，而我们假装在努力工作。",
      "source": "索尔仁尼琴 · 《伊凡·杰尼索维奇的一天》"
    },
    {
      "id": "2026-11-25-q18",
      "index": "18",
      "category": "优质影视",
      "emotion": "疲惫疏离",
      "technique": "客观时间锚定",
      "text": "我花了整整二十年学会微笑，却在一秒钟内被现实打回原形。",
      "source": "托德·菲利普斯 · 《小丑》"
    },
    {
      "id": "2026-11-25-q19",
      "index": "19",
      "category": "外国文学",
      "emotion": "清醒刺痛",
      "technique": "物态化比喻",
      "text": "There is no exquisite beauty without some strangeness in the proportion.",
      "source": "埃德加·爱伦·坡 · 《利盖亚》"
    }
  ]
}