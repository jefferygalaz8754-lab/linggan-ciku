  "quotes": [
    {
      "id": "2026-11-26-q01",
      "index": "01",
      "category": "外国文学",
      "emotion": "清醒刺痛",
      "technique": "反常归谬",
      "text": "人生在世，绝不能事事都指望别人，连影子在黑暗中都会离开你。",
      "source": "阿尔贝·加缪 · 《局外人》"
    },
    {
      "id": "2026-11-26-q02",
      "index": "02",
      "category": "外国文学",
      "emotion": "贫困挣扎",
      "technique": "底层写实与阶级困局",
      "text": "贫穷不是缺乏美德，而是缺乏金钱；饥饿不是诗意，是胃袋的抽搐。",
      "source": "乔治·奥威尔 · 《巴黎伦敦落魄记》"
    },
    {
      "id": "2026-11-26-q03",
      "index": "03",
      "category": "外国文学",
      "emotion": "疲惫疏离",
      "technique": "客观时间锚定",
      "text": "钟表的声音像极了在骨骼上凿刻痕迹，走得越准，空虚就越清晰。",
      "source": "威廉·福克纳 · 《喧哗与骚动》"
    },
    {
      "id": "2026-11-26-q04",
      "index": "04",
      "category": "外国文学",
      "emotion": "幻灭疏离",
      "technique": "物态化比喻",
      "text": "我们都在自己的生活里扮演雕像，等待灰尘把最后一点血色掩埋。",
      "source": "弗朗茨·卡夫卡 · 《城堡》"
    },
    {
      "id": "2026-11-26-q05",
      "index": "05",
      "category": "外国文学",
      "emotion": "锋利自嘲",
      "technique": "口语反转",
      "text": "我把自己拆得七零八落，也不过是为了拼凑出一个体面的笑柄。",
      "source": "陀思妥耶夫斯基 · 《地下室手记》"
    },
    {
      "id": "2026-11-26-q06",
      "index": "06",
      "category": "中文小说",
      "emotion": "清醒刺痛",
      "technique": "递进设问与心理刺探",
      "text": "你到底是在同情那个受苦的人，还是在享受自己高高在上的慈悲？",
      "source": "史铁生 · 《务虚笔记》"
    },
    {
      "id": "2026-11-26-q07",
      "index": "07",
      "category": "中文小说",
      "emotion": "贫困挣扎",
      "technique": "底层写实与阶级困局",
      "text": "车夫的命是洋车拉出来的，拉得动是汗，拉不动就成了棺材板。",
      "source": "老舍 · 《骆驼祥子》"
    },
    {
      "id": "2026-11-26-q08",
      "index": "08",
      "category": "散文随笔",
      "emotion": "绝望挽留",
      "technique": "温柔反讽",
      "text": "我用尽全力挽留你的背影，却只抓到了一手干燥而刺骨的冷风。",
      "source": "木心 · 《文学回忆录》"
    },
    {
      "id": "2026-11-26-q09",
      "index": "09",
      "category": "外国文学",
      "emotion": "荒诞自嘲",
      "technique": "逻辑倒错",
      "text": "他死前唯一感到欣慰的事，就是终于不必再为生活寻找任何借口了。",
      "source": "米兰·昆德拉 · 《不能承受的生命之轻》"
    },
    {
      "id": "2026-11-26-q10",
      "index": "10",
      "category": "中文小说",
      "emotion": "疲惫疏离",
      "technique": "物态化比喻",
      "text": "那一晚的月亮像一块发霉的冷白年糕，贴在瓦片上毫无热气。",
      "source": "张爱玲 · 《金锁记》"
    },
    {
      "id": "2026-11-26-q11",
      "index": "11",
      "category": "外国文学",
      "emotion": "清醒刺痛",
      "technique": "锋利自嘲",
      "text": "我唯一的防御手段，就是抢在别人动手之前先把我自己羞辱一遍。",
      "source": "让-保罗·萨特 · 《恶心》"
    },
    {
      "id": "2026-11-26-q12",
      "index": "12",
      "category": "纪实访谈",
      "emotion": "贫困挣扎",
      "technique": "底层写实与阶级困局",
      "text": "流水线不会为你停一秒，掉落的螺丝比工人的指甲盖更值钱。",
      "source": "梁鸿 · 《中国在梁庄》"
    },
    {
      "id": "2026-11-26-q13",
      "index": "13",
      "category": "外国文学",
      "emotion": "绝望挽留",
      "technique": "递进设问与心理刺探",
      "text": "你既然决定了要走，为何还要把这扇门留下一道能灌风的缝隙？",
      "source": "加夫列尔·加西亚·马尔克斯 · 《霍乱时期的爱情》"
    },
    {
      "id": "2026-11-26-q14",
      "index": "14",
      "category": "中文小说",
      "emotion": "幻灭疏离",
      "technique": "客观时间锚定",
      "text": "三十岁那天早晨，他看着水池里的牙膏沫，知道青春早已溺亡。",
      "source": "王小波 · 《黄金时代》"
    },
    {
      "id": "2026-11-26-q15",
      "index": "15",
      "category": "外国文学",
      "emotion": "荒诞自嘲",
      "technique": "温柔反讽",
      "text": "所有人都在庆祝胜利，只有倒在战壕里的泥浆人知道那是逃跑。",
      "source": "海明威 · 《永别了，武器》"
    },
    {
      "id": "2026-11-26-q16",
      "index": "16",
      "category": "外国文学",
      "emotion": "疲惫疏离",
      "technique": "物态化比喻",
      "text": "生活像一块吸饱了脏水的海绵，无论你怎么挤压，滴出的都是灰尘。",
      "source": "雷蒙德·卡佛 · 《当我们谈论爱情时我们在谈论什么》"
    },
    {
      "id": "2026-11-26-q17",
      "index": "17",
      "category": "优质影视",
      "emotion": "清醒刺痛",
      "technique": "口语反转",
      "text": "如果记忆也是一个罐头，我希望它永远不会过期；但它早就发臭了。",
      "source": "王家卫 · 《重庆森林》"
    },
    {
      "id": "2026-11-26-q18",
      "index": "18",
      "category": "散文随笔",
      "emotion": "贫困挣扎",
      "technique": "底层写实与阶级困局",
      "text": "街角修鞋匠手里的锥子，比任何高谈阔论都更懂得皮革的坚硬。",
      "source": "鲁迅 · 《朝花夕拾》"
    },
    {
      "id": "2026-11-26-q19",
      "index": "19",
      "category": "优质影视",
      "emotion": "幻灭疏离",
      "technique": "逻辑倒错",
      "text": "你以为你逃出了围城，其实只是从一个监牢换到了更大的操场。",
      "source": "钱锺书 · 《围城》"
    }
  ]
