  "quotes": [
    {
      "id": "2026-11-27-q01",
      "index": "01",
      "category": "外国文学",
      "emotion": "清醒刺痛",
      "technique": "锋利自嘲",
      "text": "人只有在感到自己是受害者时，才最容易心安理得地展示残忍。",
      "source": "阿尔贝·加缪 · 《局外人》"
    },
    {
      "id": "2026-11-27-q02",
      "index": "02",
      "category": "外国文学",
      "emotion": "疲惫疏离",
      "technique": "留白张力",
      "text": "在人生的中途，我迷失在一个幽暗的森林里，不知出路何在。",
      "source": "但丁 · 《神曲》"
    },
    {
      "id": "2026-11-27-q03",
      "index": "03",
      "category": "华语文学",
      "emotion": "清醒刺痛",
      "technique": "底层写实与阶级困局",
      "text": "苦难就是苦难，苦难不会带来成功，苦难不值得追求。",
      "source": "余华 · 《活着》"
    },
    {
      "id": "2026-11-27-q04",
      "index": "04",
      "category": "纪实访谈",
      "emotion": "疲惫疏离",
      "technique": "具象写实",
      "text": "你以为日子是一天一天过去的，其实它是一块一块被时间割走的。",
      "source": "柴静 · 《看见》"
    },
    {
      "id": "2026-11-27-q05",
      "index": "05",
      "category": "外国文学",
      "emotion": "荒诞自嘲",
      "technique": "逻辑倒错",
      "text": "所有的大人都曾经是小孩子，虽然，只有少数的人记得。",
      "source": "圣埃克苏佩里 · 《小王子》"
    },
    {
      "id": "2026-11-27-q06",
      "index": "06",
      "category": "华语文学",
      "emotion": "清醒刺痛",
      "technique": "物态化比喻",
      "text": "城外的人想冲进去，城里的人想逃出来。",
      "source": "钱锺书 · 《围城》"
    },
    {
      "id": "2026-11-27-q07",
      "index": "07",
      "category": "外国文学",
      "emotion": "幻灭疏离",
      "technique": "温柔反讽",
      "text": "当记忆的锁链断裂时，整个世界不过是一片虚无。",
      "source": "马尔克斯 · 《百年孤独》"
    },
    {
      "id": "2026-11-27-q08",
      "index": "08",
      "category": "外国文学",
      "emotion": "静谧通透",
      "technique": "物态化比喻",
      "text": "人是一根会思想的芦苇，脆弱却拥有整个宇宙的重负。",
      "source": "帕斯卡尔 · 《思想录》"
    },
    {
      "id": "2026-11-27-q09",
      "index": "09",
      "category": "外国文学",
      "emotion": "清醒刺痛",
      "technique": "递进设问与心理刺探",
      "text": "谁若与怪物搏斗，应当小心自己不要也成为怪物。",
      "source": "弗里德里希·尼采 · 《善恶的彼岸》"
    },
    {
      "id": "2026-11-27-q10",
      "index": "10",
      "category": "散文随笔",
      "emotion": "静谧通透",
      "technique": "留白张力",
      "text": "我慢慢地了解到，所谓父女母子一场，只不过是目送他的背影渐行渐远。",
      "source": "龙应台 · 《目送》"
    },
    {
      "id": "2026-11-27-q11",
      "index": "11",
      "category": "优质网文",
      "emotion": "荒诞自嘲",
      "technique": "口语反转",
      "text": "大人在小孩面前总爱装得无所不知，其实大家都是第一次活。",
      "source": "江南 · 《龙族》"
    },
    {
      "id": "2026-11-27-q12",
      "index": "12",
      "category": "外国文学",
      "emotion": "疲惫疏离",
      "technique": "物态化比喻",
      "text": "今天母亲死了。也可能是昨天，我不知道。",
      "source": "加缪 · 《局外人》"
    },
    {
      "id": "2026-11-27-q13",
      "index": "13",
      "category": "外国文学",
      "emotion": "清醒刺痛",
      "technique": "底层写实与阶级困局",
      "text": "世上的富人总是以为，金钱可以弥补他们对待穷人时犯下的所有罪愆。",
      "source": "陀思妥耶夫斯基 · 《罪与罚》"
    },
    {
      "id": "2026-11-27-q14",
      "index": "14",
      "category": "外国文学",
      "emotion": "贫困挣扎",
      "technique": "痛觉代偿与具象写实",
      "text": "肚子饿的时候，连呼吸都带着一种发酸的铁锈味。",
      "source": "乔治·奥威尔 · 《巴黎伦敦落魄记》"
    },
    {
      "id": "2026-11-27-q15",
      "index": "15",
      "category": "外国文学",
      "emotion": "清醒刺痛",
      "technique": "客观时间锚定",
      "text": "时间带走一切，岁月不会为任何人保留哪怕一滴完整的眼泪。",
      "source": "毛姆 · 《月亮与六便士》"
    },
    {
      "id": "2026-11-27-q16",
      "index": "16",
      "category": "华语文学",
      "emotion": "静谧通透",
      "technique": "留白张力",
      "text": "风大得很，我一个人走在路上，心里面全是平淡的落叶。",
      "source": "汪曾祺 · 《人间草木》"
    },
    {
      "id": "2026-11-27-q17",
      "index": "17",
      "category": "外国文学",
      "emotion": "荒诞自嘲",
      "technique": "逻辑倒错",
      "text": "当大家都在疯狂的时候，唯一保持理智的人反而成了一个疯子。",
      "source": "约瑟夫·海勒 · 《第22条军规》"
    },
    {
      "id": "2026-11-27-q18",
      "index": "18",
      "category": "纪实文学",
      "emotion": "疲惫疏离",
      "technique": "痛觉代偿与具象写实",
      "text": "我们不仅在承受苦难，还在日复一日习惯被剥夺的麻木。",
      "source": "阿列克谢耶维奇 · 《切尔诺贝利的祭祷》"
    }
  ]
}