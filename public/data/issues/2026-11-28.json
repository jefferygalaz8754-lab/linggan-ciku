  "quotes": [
    {
      "id": "2026-11-28-q01",
      "index": "01",
      "category": "外国文学",
      "emotion": "幻灭疏离",
      "technique": "物态化比喻",
      "text": "人是一根会思想的芦苇，既脆弱又自以为尊贵。",
      "source": "帕斯卡尔 · 《思想录》"
    },
    {
      "id": "2026-11-28-q02",
      "index": "02",
      "category": "外国文学",
      "emotion": "清醒刺痛",
      "technique": "反常归谬与痛觉代偿",
      "text": "我反抗，故我们存在。",
      "source": "加缪 · 《反抗者》"
    },
    {
      "id": "2026-11-28-q03",
      "index": "03",
      "category": "外国文学",
      "emotion": "疲惫疏离",
      "technique": "留白张力",
      "text": "长久的沉默比任何恶毒的言语都更具摧毁力。",
      "source": "萨特 · 《禁闭》"
    },
    {
      "id": "2026-11-28-q04",
      "index": "04",
      "category": "华语散文",
      "emotion": "静谧通透",
      "technique": "客观时间锚定",
      "text": "山中何事？松花酿酒，春水煎茶。",
      "source": "张岱 · 《陶庵梦忆》"
    },
    {
      "id": "2026-11-28-q05",
      "index": "05",
      "category": "外国小说",
      "emotion": "荒诞自嘲",
      "technique": "逻辑倒错",
      "text": "当你意识到自己是疯子时，你就已经失去了疯的资格。",
      "source": "约瑟夫·海勒 · 《第二十二条军规》"
    },
    {
      "id": "2026-11-28-q06",
      "index": "06",
      "category": "现当代文学",
      "emotion": "锋利自嘲",
      "technique": "口语反转",
      "text": "人们宁愿去相信一个体面的谎言，也不愿面对难堪的真实。",
      "source": "钱钟书 · 《围城》"
    },
    {
      "id": "2026-11-28-q07",
      "index": "07",
      "category": "外国小说",
      "emotion": "贫困挣扎",
      "technique": "底层写实与阶级困局",
      "text": "贫穷不是缺乏美德，而是缺乏选择的资本。",
      "source": "乔治·奥威尔 · 《巴黎伦敦落魄记》"
    },
    {
      "id": "2026-11-28-q08",
      "index": "08",
      "category": "外国哲学",
      "emotion": "清醒刺痛",
      "technique": "反常归谬与痛觉代偿",
      "text": "没有可怕的深度，便没有美丽的水面。",
      "source": "尼采 · 《查拉图斯特拉如是说》"
    },
    {
      "id": "2026-11-28-q09",
      "index": "09",
      "category": "纪实文学",
      "emotion": "绝望挽留",
      "technique": "痛觉代偿与具象写实",
      "text": "我们都在以各自破碎的姿态，拼命向虚空中索要回应。",
      "source": "阿列克谢耶维奇 · 《切尔诺贝利的悲鸣》"
    },
    {
      "id": "2026-11-28-q10",
      "index": "10",
      "category": "外国小说",
      "emotion": "疲惫疏离",
      "technique": "物态化比喻",
      "text": "世人都在以钟表的刻度生活，唯有灵魂在迟到。",
      "source": "佩索阿 · 《不安之书》"
    },
    {
      "id": "2026-11-28-q11",
      "index": "11",
      "category": "现代小说",
      "emotion": "静谧通透",
      "technique": "留白张力",
      "text": "凡是过去，皆为序章。",
      "source": "莎士比亚 · 《暴风雨》"
    },
    {
      "id": "2026-11-28-q12",
      "index": "12",
      "category": "外国小说",
      "emotion": "幻灭疏离",
      "technique": "温柔反讽",
      "text": "我们奋力前行，小舟逆水而上，不断被推回过去。",
      "source": "菲茨杰拉德 · 《了不起的盖茨比》"
    },
    {
      "id": "2026-11-28-q13",
      "index": "13",
      "category": "外国文学",
      "emotion": "清醒刺痛",
      "technique": "递进设问与心理刺探",
      "text": "痛苦若能被叫出名字，它便失去了一半的毁灭力。",
      "source": "陀思妥耶夫斯基 · 《地下室手记》"
    },
    {
      "id": "2026-11-28-q14",
      "index": "14",
      "category": "现当代随笔",
      "emotion": "锋利自嘲",
      "technique": "口语反转",
      "text": "人类最大的教训，就是从未在教训中学会任何敬畏。",
      "source": "黑格尔 · 《历史哲学》"
    },
    {
      "id": "2026-11-28-q15",
      "index": "15",
      "category": "外国小说",
      "emotion": "荒诞自嘲",
      "technique": "物态化比喻",
      "text": "生活就是一团乱麻，每个人都在假装精通解结之道。",
      "source": "米兰·昆德拉 · 《不朽》"
    },
    {
      "id": "2026-11-28-q16",
      "index": "16",
      "category": "华语散文",
      "emotion": "静谧通透",
      "technique": "客观时间锚定",
      "text": "在这个光怪陆离的人间，没有谁可以将日子过得滴水不漏。",
      "source": "林徽因 · 《你是人间的四月天》"
    },
    {
      "id": "2026-11-28-q17",
      "index": "17",
      "category": "外国小说",
      "emotion": "绝望挽留",
      "technique": "反常归谬与痛觉代偿",
      "text": "你越是逃避惩罚，内心的绞架越是高耸入云。",
      "source": "卡夫卡 · 《审判》"
    },
    {
      "id": "2026-11-28-q18",
      "index": "18",
      "category": "优质影视",
      "emotion": "幻灭疏离",
      "technique": "温柔反讽",
      "text": "我以为我们很特别，原来大家都不过是在按部就班地告别。",
      "source": "王家卫 · 《重庆森林》"
    },
    {
      "id": "2026-11-28-q19",
      "index": "19",
      "category": "外国文学",
      "emotion": "疲惫疏离",
      "technique": "留白张力",
      "text": "所有深渊在凝视你时，都曾悄悄叹了一口气。",
      "source": "博尔赫斯 · 《小径分岔的花园》"
    },
    {
      "id": "2026-11-28-q20",
      "index": "20",
      "category": "纪实访谈",
      "emotion": "贫困挣扎",
      "technique": "底层写实与阶级困局",
      "text": "在生存的重压之下，尊严往往是最先被典当的奢侈品。",
      "source": "何伟 · 《江城》"
    }
  ]
