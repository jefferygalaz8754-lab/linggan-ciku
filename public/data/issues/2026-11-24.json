  "quotes": [
    {
      "id": "2026-11-24-q01",
      "index": "01",
      "category": "外国文学",
      "emotion": "虚无苍茫",
      "technique": "白描比喻",
      "text": "我们都在阴沟里，但仍有人仰望星空。",
      "source": "王尔德 · 《温夫人的扇子》"
    },
    {
      "id": "2026-11-24-q02",
      "index": "02",
      "category": "经典小说",
      "emotion": "绝望韧性",
      "technique": "警句格言",
      "text": "人不是为失败而生的，一个人可以被毁灭，但不能给打败。",
      "source": "海明威 · 《老人与海》"
    },
    {
      "id": "2026-11-24-q03",
      "index": "03",
      "category": "现当代散文",
      "emotion": "恬淡旷达",
      "technique": "生活白描",
      "text": "四方食事，不过一碗人间烟火。",
      "source": "汪曾祺 · 《人间滋味》"
    },
    {
      "id": "2026-11-24-q04",
      "index": "04",
      "category": "经典小说",
      "emotion": "苍凉幻灭",
      "technique": "物象反讽",
      "text": "生命是一袭华美的袍，爬满了蚤子。",
      "source": "张爱玲 · 《天才梦》"
    },
    {
      "id": "2026-11-24-q05",
      "index": "05",
      "category": "外国文学",
      "emotion": "荒诞冷峻",
      "technique": "平静陈述",
      "text": "今天，妈妈死了。也许是昨天，我不知道。",
      "source": "加缪 · 《局外人》"
    },
    {
      "id": "2026-11-24-q06",
      "index": "06",
      "category": "外国文学",
      "emotion": "时光叹喟",
      "technique": "时间跳跃",
      "text": "多年以后，面对行刑队，奥雷里亚诺·布恩迪亚上校将会回想起父亲带他去见识冰块的那个下午。",
      "source": "加西亚·马尔克斯 · 《百年孤独》"
    },
    {
      "id": "2026-11-24-q07",
      "index": "07",
      "category": "经典小说",
      "emotion": "清醒克制",
      "technique": "设问反思",
      "text": "在这个世界上，所有真性情的人，想法总是与众不同。",
      "source": "沈从文 · 《边城》"
    },
    {
      "id": "2026-11-24-q08",
      "index": "08",
      "category": "经典散文",
      "emotion": "宿命释然",
      "technique": "具象化拟人",
      "text": "死是一件不必急于求成的事，一个必然会降临的节日。",
      "source": "史铁生 · 《我与地坛》"
    },
    {
      "id": "2026-11-24-q09",
      "index": "09",
      "category": "优质影视",
      "emotion": "自由信念",
      "technique": "隐喻象征",
      "text": "有些鸟是关不住的，它们的每一片羽毛都闪耀着自由的光辉。",
      "source": "弗兰克·德拉邦特 · 《肖申克的救赎》"
    },
    {
      "id": "2026-11-24-q10",
      "index": "10",
      "category": "外国文学",
      "emotion": "深沉守望",
      "technique": "情感留白",
      "text": "我一直在寻找某种东西，但那究竟是什么，连我自己也不知道。",
      "source": "村上春树 · 《挪威的森林》"
    },
    {
      "id": "2026-11-24-q11",
      "index": "11",
      "category": "经典小说",
      "emotion": "围城困局",
      "technique": "冷峻讽刺",
      "text": "城外的人想冲进去，城里的人想逃出来。",
      "source": "钱锺书 · 《围城》"
    },
    {
      "id": "2026-11-24-q12",
      "index": "12",
      "category": "优质影视",
      "emotion": "人生况味",
      "technique": "经典比喻",
      "text": "人生就像一盒巧克力，你永远不知道下一颗是什么味道。",
      "source": "罗伯特·泽米吉斯 · 《阿甘正传》"
    },
    {
      "id": "2026-11-24-q13",
      "index": "13",
      "category": "经典散文",
      "emotion": "思念笃定",
      "technique": "时间沉淀",
      "text": "你若安好，便是晴天。",
      "source": "白落梅 · 《你若安好便是晴天》"
    },
    {
      "id": "2026-11-24-q14",
      "index": "14",
      "category": "纪实访谈",
      "emotion": "悲悯理解",
      "technique": "客观陈述",
      "text": "痛苦是免不了的，可是我答应你，伤口总会结痂。",
      "source": "柴静 · 《看见》"
    },
    {
      "id": "2026-11-24-q15",
      "index": "15",
      "category": "外国文学",
      "emotion": "纯真守望",
      "technique": "哲学隐喻",
      "text": "真正重要的东西，用眼睛是看不见的。",
      "source": "安托万·德·圣-埃克苏佩里 · 《小王子》"
    },
    {
      "id": "2026-11-24-q16",
      "index": "16",
      "category": "经典小说",
      "emotion": "历史重荷",
      "technique": "量化夸张",
      "text": "时代的一粒灰，落在个人头上，就是一座山。",
      "source": "方方 · 《武汉日记》"
    },
    {
      "id": "2026-11-24-q17",
      "index": "17",
      "category": "优质影视",
      "emotion": "遗憾怅惘",
      "technique": "对比克制",
      "text": "如果多一张船票，你愿不愿意跟我一起走？",
      "source": "王家卫 · 《花样年华》"
    },
    {
      "id": "2026-11-24-q18",
      "index": "18",
      "category": "外国文学",
      "emotion": "存在自省",
      "technique": "直接断言",
      "text": "每个人的生命都是通向他自己的桥梁。",
      "source": "赫尔曼·黑塞 · 《德米安》"
    },
    {
      "id": "2026-11-24-q19",
      "index": "19",
      "category": "经典小说",
      "emotion": "苍凉隐忍",
      "technique": "生活沉淀",
      "text": "少年去游荡，中年想掘藏，老年做和尚。",
      "source": "余华 · 《活着》"
    },
    {
      "id": "2026-11-24-q20",
      "index": "20",
      "category": "外国文学",
      "emotion": "永恒执着",
      "technique": "时空对比",
      "text": "So we beat on, boats against the current, borne back ceaselessly into the past.",
      "source": "F·司各特·菲茨杰拉德 · 《了不起的盖茨比》"
    }
  ]
}
