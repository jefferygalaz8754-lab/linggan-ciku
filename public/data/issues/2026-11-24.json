  "quotes": [
    {
      "id": "2026-11-24-q01",
      "index": "01",
      "category": "文学摘录",
      "emotion": "宿命沉沦",
      "technique": "残酷拟人",
      "text": "生命中曾经有过的所有灿烂，终究都需要用寂寞来偿还。",
      "source": "加西亚·马尔克斯 · 《百年孤独》"
    },
    {
      "id": "2026-11-24-q02",
      "index": "02",
      "category": "文学摘录",
      "emotion": "苍凉透彻",
      "technique": "通感对冲",
      "text": "生命是一袭华美的袍，爬满了蚤子。",
      "source": "张爱玲 · 《天才梦》"
    },
    {
      "id": "2026-11-24-q03",
      "index": "03",
      "category": "文学摘录",
      "emotion": "清醒抗辩",
      "technique": "反语隐喻",
      "text": "人们之所以必须喝酒，是因为在这世上保持清醒需要承担过分的代价。",
      "source": "太宰治 · 《斜阳》"
    },
    {
      "id": "2026-11-24-q04",
      "index": "04",
      "category": "文学摘录",
      "emotion": "存在虚无",
      "technique": "冷峻陈述",
      "text": "今天，妈妈死了。也许是昨天，我不知道。",
      "source": "阿尔贝·加缪 · 《局外人》"
    },
    {
      "id": "2026-11-24-q05",
      "index": "05",
      "category": "文学摘录",
      "emotion": "孤立无援",
      "technique": "微观空间具象",
      "text": "心脏是一座有两间卧室的房子，一间住着痛苦，另一间住着欢乐。",
      "source": "赫尔曼·黑塞 · 《荒原狼》"
    },
    {
      "id": "2026-11-24-q06",
      "index": "06",
      "category": "文学摘录",
      "emotion": "绝望挽留",
      "technique": "物态化比喻",
      "text": "记忆是一张网，捕捉到的大多是不情愿带走的碎屑。",
      "source": "弗吉尼亚·伍尔夫 · 《达洛维夫人》"
    },
    {
      "id": "2026-11-24-q07",
      "index": "07",
      "category": "影视台词",
      "emotion": "幻灭疏离",
      "technique": "客观时间锚定",
      "text": "不知道从什么时候开始，在每一个东西上面都有个日子。",
      "source": "王家卫 · 《重庆森林》"
    },
    {
      "id": "2026-11-24-q08",
      "index": "08",
      "category": "文学摘录",
      "emotion": "深沉克制",
      "technique": "时空缩微",
      "text": "后来许多人问我一个人夜晚怎么走过，我回答：天黑就闭眼。",
      "source": "史铁生 · 《病隙碎笔》"
    },
    {
      "id": "2026-11-24-q09",
      "index": "09",
      "category": "文学摘录",
      "emotion": "锋利自嘲",
      "technique": "逻辑倒错",
      "text": "我以为你是在救我，没想到你只是在找一个合谋者。",
      "source": "博尔赫斯 · 《恶棍列传》"
    },
    {
      "id": "2026-11-24-q10",
      "index": "10",
      "category": "文学摘录",
      "emotion": "执念撕扯",
      "technique": "动态白描",
      "text": "我甚至连他的一根头发都舍不得碰，可他把我的整座世界拆了。",
      "source": "艾米莉·勃朗特 · 《呼啸山庄》"
    },
    {
      "id": "2026-11-24-q11",
      "index": "11",
      "category": "文学摘录",
      "emotion": "顿悟苍白",
      "technique": "极端对比",
      "text": "所有的大人都曾经是小孩，虽然，只有少数的人记得。",
      "source": "安托万·德·圣-埃克苏佩里 · 《小王子》"
    },
    {
      "id": "2026-11-24-q12",
      "index": "12",
      "category": "纪实访谈",
      "emotion": "生存警醒",
      "technique": "冷面口语",
      "text": "生活不需要那么多壮怀激烈，活着本身就是最大的抵抗。",
      "source": "阿列克谢耶维奇 · 《二手时间》"
    },
    {
      "id": "2026-11-24-q13",
      "index": "13",
      "category": "影视台词",
      "emotion": "隐秘情愫",
      "technique": "留白造境",
      "text": "如果多一张船票，你愿不愿意跟我一起走？",
      "source": "王家卫 · 《花样年华》"
    },
    {
      "id": "2026-11-24-q14",
      "index": "14",
      "category": "文学摘录",
      "emotion": "灵魂灼烧",
      "technique": "物象化移情",
      "text": "爱是想要触碰却又收回手。",
      "source": "J.D.塞林格 · 《破碎故事之心》"
    },
    {
      "id": "2026-11-24-q15",
      "index": "15",
      "category": "文学摘录",
      "emotion": "平淡释怀",
      "technique": "视觉延展",
      "text": "庭有枇杷树，吾妻死之年所手植也，今已亭亭如盖矣。",
      "source": "归有光 · 《项脊轩志》"
    },
    {
      "id": "2026-11-24-q16",
      "index": "16",
      "category": "外国文学",
      "emotion": "永恒孤独",
      "technique": "极简短句",
      "text": "So we beat on, boats against the current, borne back ceaselessly into the past.",
      "source": "F. Scott Fitzgerald · 《The Great Gatsby》"
    },
    {
      "id": "2026-11-24-q17",
      "index": "17",
      "category": "文学摘录",
      "emotion": "沉重包容",
      "technique": "隐喻定性",
      "text": "人是为了审判自己才生存的，不是为了被宽恕。",
      "source": "陀思妥耶夫斯基 · 《卡拉马佐夫兄弟》"
    },
    {
      "id": "2026-11-24-q18",
      "index": "18",
      "category": "影视台词",
      "emotion": "告别虚妄",
      "technique": "排比消解",
      "text": "All those moments will be lost in time, like tears in rain.",
      "source": "雷德利·斯科特 · 《银翼杀手》"
    },
    {
      "id": "2026-11-24-q19",
      "index": "19",
      "category": "文学摘录",
      "emotion": "清醒悲悯",
      "technique": "逆向思辨",
      "text": "真正有价值的悲剧，不是善与恶的决斗，而是两种神圣力量的碰撞。",
      "source": "黑格尔 · 《美学讲演录》"
    },
    {
      "id": "2026-11-24-q20",
      "index": "20",
      "category": "文学摘录",
      "emotion": "残存温柔",
      "technique": "具象化温度",
      "text": "在这个薄情的世界里，深情地活着。",
      "source": "丰子恺 · 《活着本来单纯》"
    }
  ]
